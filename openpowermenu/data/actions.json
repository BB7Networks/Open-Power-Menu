  "logs": {
    "title": "System Logs",
    "icon": "view-list-details",
    "commands": [
      [
        "ksystemlog"
      ],
      {
        "argv": [
          "konsole",
          "--hold",
          "-e",
          "journalctl",
          "-b",
          "-p",
          "warning",
          "-n",
          "1000",
          "--follow",
          "--no-pager"
        ],
        "requires": [
          "journalctl"
        ]
      },
      {
        "argv": [
          "xterm",
          "-hold",
          "-e",
          "journalctl",
          "-b",
          "-p",
          "warning",
          "-n",
          "1000",
          "--follow",
          "--no-pager"
        ],
        "requires": [
          "journalctl"
        ]
      }
    ]
  },
