file(READ "@CMAKE_BINARY_DIR@/native-bundle/bundle.json" manifest)
foreach(field os os_version cpu)
  string(JSON ${field} GET "${manifest}" ${field})
endforeach()
set(archive "OpenPowerMenu-@PROJECT_VERSION@-dev-${os}-${os_version}-${cpu}.tar.gz")
execute_process(COMMAND "@CMAKE_COMMAND@" -E tar czf "${archive}" --format=gnutar native-bundle WORKING_DIRECTORY "@CMAKE_BINARY_DIR@" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "@CMAKE_BINARY_DIR@/${archive}" digest)
file(WRITE "@CMAKE_BINARY_DIR@/${archive}.sha256" "${digest}  ${archive}\n")
execute_process(COMMAND "@CMAKE_COMMAND@" -E tar cf "@CMAKE_BINARY_DIR@/org.openpowermenu.start-@PROJECT_VERSION@-dev.plasmoid" --format=zip metadata.json contents WORKING_DIRECTORY "@CMAKE_BINARY_DIR@/native-bundle/widget" COMMAND_ERROR_IS_FATAL ANY)
