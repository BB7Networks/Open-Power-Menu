set(bundle "@CMAKE_BINARY_DIR@/native-bundle")
file(REMOVE_RECURSE "${bundle}")
file(MAKE_DIRECTORY "${bundle}/app/bin" "${bundle}/app/docs")
foreach(binary open-power-menu-native open-power-menu-editor open-power-menu-standalone open-power-menu-install open-power-menu)
  file(COPY "@CMAKE_BINARY_DIR@/native/${binary}" DESTINATION "${bundle}/app/bin" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endforeach()
file(COPY "@PROJECT_SOURCE_DIR@/plasmoid/" DESTINATION "${bundle}/widget")
file(READ "${bundle}/widget/metadata.json" metadata)
string(JSON metadata SET "${metadata}" KPlugin Version "\"@PROJECT_VERSION@-dev\"")
file(WRITE "${bundle}/widget/metadata.json" "${metadata}\n")
file(COPY "@PROJECT_SOURCE_DIR@/assets/open-power-menu.svg" DESTINATION "${bundle}")
file(COPY "@PROJECT_SOURCE_DIR@/docs/KDE-STORE.md" "@PROJECT_SOURCE_DIR@/docs/TESTING.md" DESTINATION "${bundle}/app/docs")
file(COPY "@PROJECT_SOURCE_DIR@/LICENSE" "@PROJECT_SOURCE_DIR@/native/packaging/README.md" DESTINATION "${bundle}/app/docs")
file(COPY "@CMAKE_CURRENT_BINARY_DIR@/install.sh" "@CMAKE_CURRENT_BINARY_DIR@/uninstall.sh" DESTINATION "${bundle}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
file(CHMOD_RECURSE "${bundle}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
file(GLOB executables "${bundle}/app/bin/*")
file(CHMOD ${executables} "${bundle}/install.sh" "${bundle}/uninstall.sh" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
execute_process(COMMAND "@CMAKE_BINARY_DIR@/native/open-power-menu-install" --seal-bundle "${bundle}" COMMAND_ERROR_IS_FATAL ANY)
file(CHMOD "${bundle}/bundle.json" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
